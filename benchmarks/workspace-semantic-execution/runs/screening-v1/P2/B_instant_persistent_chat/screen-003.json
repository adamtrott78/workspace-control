  "established_findings": [
    {
      "id": "F_initial",
      "statement": "O1 shows high latency/retries at concurrency 64; O3 shows CPU below 48% and queue occupancy below 62%, weakening queue-capacity saturation as the primary mechanism."
    },
    {
      "id": "F_pool_reuse",
      "statement": "Control-published E_disable_pool_reuse result: p95 latency 228 ms and mean retries 1.1 versus O1 baseline 412 ms and 3.1. Pool reuse is therefore materially involved in the regression, while this intervention alone does not isolate retained retry state from other reuse-linked mechanisms.",
      "result_hash": "7f42dfe675809352aa634a18b7387e8a138d989e866b836df49ff880c1feae4c"
    },
    {
      "id": "F_retry_reset",
      "statement": "Control-published E_force_retry_reset result: with pool reuse enabled, resetting retry state at each request boundary yields p95 latency 219 ms and mean retries 1.0. This reproduces and slightly exceeds the improvement from disabling pool reuse, isolating retained retry state across pooled request lifecycles as the primary mechanism.",
      "result_hash": "6973b14a40f19f51affa6a066311bedf5f1a1f129cc0d2fd1e8fc10b98dbe820"
    },
    {
      "id": "F_clock_quantization",
      "statement": "Control-published E_clock_quantization result: replacing quantized timeout timestamps with monotonic high-resolution timestamps yields p95 latency 401 ms and mean retries 3.0, close to O1 baseline 412 ms and 3.1. Timestamp quantization therefore does not materially explain the regression.",
      "result_hash": "b590b361298c6683d7c03db86ba9c83f50404b54bffcf23c76e7e08946836c17"
    }
  ],
