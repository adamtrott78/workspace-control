  "established_findings": [
    {
      "id": "F_starting_observations",
      "basis": [
        "O1",
        "O2",
        "O3",
        "O4"
      ],
      "finding": "The regression combines load-sensitive latency with retry amplification that persists under regional load relief; low CPU/queue occupancy and cross-region-correlated retry bursts make pure regional capacity saturation an incomplete primary explanation."
    },
    {
      "id": "F_E_isolate_r1",
      "basis": [
        "E_isolate_r1",
        "060a0b1fc89c29230996c53a04e1e916657d1addf34dc3d9b75f609f56a0caa4"
      ],
      "finding": "Isolating region 1 from cross-region retry propagation reduced r1 p95 latency from the observed elevated regime to 315 ms and mean retries to 1.9, while other regions did not materially change. This is evidence that cross-region propagation contributes causally to the local regression, but a single regional isolation does not yet distinguish retained retry-state feedback from a cross-region timing/synchronization mechanism."
    },
    {
      "id": "F_E_isolate_r2",
      "basis": [
        "E_isolate_r2",
        "e0e8835a79c43d823bc3373bafb09736f035af5684a5bb0f2e9704880f4bef99"
      ],
      "finding": "Isolating region 2 from cross-region retry propagation reduced r2 p95 latency to 322 ms and mean retries to 2.0, while other regions did not materially change. This independently replicates the region-1 pattern, strengthening evidence that cross-region propagation causally contributes to the regression while still leaving retained retry-state feedback versus synchronized timing unresolved."
    },
    {
      "id": "F_E_isolate_r3",
      "basis": [
        "E_isolate_r3",
        "e18f92dce94488e1730333420fc30a468bcdac8413fd4794d060f67c915b1a0a"
      ],
      "finding": "Isolating region 3 from cross-region retry propagation reduced r3 p95 latency to 318 ms and mean retries to 1.8, while other regions did not materially change. This third independent replication establishes a highly consistent region-local benefit from severing cross-region propagation, but it still does not by itself distinguish retained retry-state feedback from synchronized retry timing."
    },
    {
      "id": "F_E_isolate_r4",
      "basis": [
        "E_isolate_r4",
        "65e2e567e2658846ae317dc3206f69d7c9390db38fd03a69f4017cea137045f5"
      ],
      "finding": "Isolating region 4 from cross-region retry propagation reduced r4 p95 latency to 326 ms and mean retries to 2.0, while other regions did not materially change. This fourth independent replication completes regional coverage and shows a consistent region-local benefit from severing cross-region propagation across all four regions."
    },
    {
