    "max_completion_cas_attempts_per_action": 3,
    "max_code_repair_iterations_per_action": 3,
    "worker_registration": "fresh worker atomically claims lexicographically smallest FREE worker slot by exact-head CAS before action selection; preserve all peer state; once registered, retain that worker_id for the chat",
