    "execution": "create per-action execution branch from frozen base_main_sha; modify exactly the two files named by the action; draft PR; automatic Workspace Control Validation",
    "completion": "after exact-head validation success, reread shared branch; preserve all peer state; set owned action COMPLETE with branch/PR/head/run; increment state_version; exact-head CAS",
    "completion_conflict": "reread shared state, preserve valid peer transitions, retry own completion",
    "worker_loop": "after successful completion, immediately attempt next eligible action; yield only for async validation, retryable tool/read barrier, no eligible work, or terminal failure",
