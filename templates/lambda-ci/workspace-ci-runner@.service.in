# STATIC TEMPLATE ONLY — not installed in P1.
[Unit]
Description=Workspace CI ephemeral runner %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ci-research-engine
Group=ci-research-engine
WorkingDirectory=__JOB_DIR__
ExecStart=__RUNNER_DIR__/run.sh

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

ReadWritePaths=__JOB_DIR__
ReadWritePaths=/srv/workspace-ci/research-engine/staging-cache
ReadWritePaths=/srv/workspace-ci/research-engine/home
ReadOnlyPaths=/srv/workspace-ci/research-engine/trusted-cache
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/run/docker.sock

DevicePolicy=closed
__DEVICE_ALLOW_LINES__

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
__NETWORK_POLICY_LINES__

CPUQuota=__CPU_QUOTA__
MemoryHigh=__MEMORY_HIGH__
MemoryMax=__MEMORY_MAX__
TasksMax=__TASKS_MAX__
RuntimeMaxSec=__RUNTIME_MAX__

KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=20s

Environment=HOME=/srv/workspace-ci/research-engine/home
Environment=XDG_CACHE_HOME=/srv/workspace-ci/research-engine/staging-cache
Environment=HF_HOME=/srv/workspace-ci/research-engine/staging-cache/huggingface
Environment=TRANSFORMERS_CACHE=/srv/workspace-ci/research-engine/staging-cache/huggingface/transformers
Environment=ACTIONS_RUNNER_INPUT_JITCONFIG=__INJECTED_BY_PROVISIONER_NOT_FILE__

[Install]
WantedBy=multi-user.target
