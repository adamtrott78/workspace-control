# RUN-3 INSTALLED GENERIC SERVICE TEMPLATE.
[Unit]
Description=Workspace CI project/lane scale-set controller %i
Requires=workspace-ci-provisioner.service
After=network-online.target workspace-ci-provisioner.service
Wants=network-online.target

[Service]
Type=simple
User=ci-controller
Group=workspace-ci-controller
ExecStart=/opt/workspace-ci/controller/lambda-ci-controller
EnvironmentFile=/etc/workspace-ci/controllers/%i.env
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.53/32
IPAddressDeny=127.0.0.0/8
IPAddressDeny=::1/128
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fe80::/10
IPAddressDeny=fc00::/7
ReadOnlyPaths=/var/lib/workspace-ci/controller/github-token
InaccessiblePaths=/home/atrott /var/run/docker.sock /run/docker.sock
DevicePolicy=closed
TasksMax=256
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
