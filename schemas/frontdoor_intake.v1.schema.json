{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-control://schemas/frontdoor_intake.v1.schema.json",
  "title": "Workspace Control Front-door Intake Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "submitted_at",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "FRONTDOOR_TASK_INTAKE_CANDIDATE"
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_id",
        "message_id",
        "conversation_id",
        "objective",
        "source_ref",
        "requested_by",
        "authorization_state"
      ],
      "properties": {
        "intake_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "requested_by": {
          "const": "human"
        },
        "authorization_state": {
          "const": "UNDECIDED"
        }
      }
    }
  }
}
