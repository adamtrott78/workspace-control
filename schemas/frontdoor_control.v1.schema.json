{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-control://schemas/frontdoor_control.v1.schema.json",
  "title": "Workspace Control Front-door Task Control Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "submitted_at",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "FRONTDOOR_TASK_CONTROL_CANDIDATE"
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "message_id",
        "conversation_id",
        "intent",
        "target_task_id",
        "text",
        "source_ref",
        "requested_by",
        "authorization_state"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "RESUME_TASK",
            "PROVIDE_DECISION",
            "CANCEL_REQUEST"
          ]
        },
        "target_task_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "requested_by": {
          "const": "human"
        },
        "authorization_state": {
          "const": "UNDECIDED"
        }
      }
    }
  }
}
