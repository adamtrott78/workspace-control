{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/task_capsule.schema.json",
  "title": "Workspace Control Task Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "status",
    "goal",
    "acceptance_criteria",
    "constraints",
    "repositories",
    "decisions",
    "executed_operations",
    "artifacts",
    "validation",
    "blockers",
    "remaining_work",
    "next_safe_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "VALIDATING",
        "CHECKPOINTED",
        "BLOCKED_RUNTIME",
        "BLOCKED_EVIDENCE",
        "NEEDS_USER_DECISION",
        "COMPLETE"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executed_operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/executed_operation"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_safe_action": {
      "type": "string",
      "minLength": 1
    },
    "last_executor": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "intent",
        "checkout_path",
        "branch",
        "base_sha",
        "checkpoint_sha",
        "checkpoint_pushed",
        "allowed_mutation_scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "read",
            "mutate"
          ]
        },
        "checkout_path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checkpoint_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checkpoint_pushed": {
          "type": "boolean"
        },
        "allowed_mutation_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executed_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "result",
        "evidence"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
