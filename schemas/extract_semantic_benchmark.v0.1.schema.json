{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/extract_semantic_benchmark.v0.1.schema.json",
  "title": "Held-Out Local EXTRACT Semantic Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "split",
    "paper",
    "obligations",
    "annotation_provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "PILOT",
        "ACCEPTANCE"
      ]
    },
    "paper": {
      "$ref": "#/$defs/paper"
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "annotation_provenance": {
      "$ref": "#/$defs/annotation_provenance"
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_paper_id",
        "arxiv_id",
        "version",
        "title",
        "source_pdf_url",
        "source_sha256",
        "page_count"
      ],
      "properties": {
        "benchmark_paper_id": {
          "type": "string",
          "minLength": 1
        },
        "arxiv_id": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{4,5}$"
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_pdf_url": {
          "type": "string",
          "pattern": "^https://arxiv\\.org/pdf/"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "page_number",
        "anchor_excerpt"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "anchor_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "canonical_span_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "type",
        "importance",
        "normalized_claim",
        "support_mode",
        "quotes",
        "duplicate_group",
        "annotation_rationale",
        "adjudication_state"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "METHOD",
            "DATASET_SETUP",
            "RESULT",
            "LIMITATION",
            "ROBUSTNESS_GENERALIZATION",
            "SECURITY_THREAT",
            "EVALUATION_PROTOCOL",
            "ASSUMPTION_SCOPE"
          ]
        },
        "importance": {
          "enum": [
            "CORE",
            "SECONDARY"
          ]
        },
        "normalized_claim": {
          "type": "string",
          "minLength": 1
        },
        "support_mode": {
          "enum": [
            "DIRECT",
            "COMPOSITE",
            "TABLE_OR_FIGURE_GROUNDED"
          ]
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "duplicate_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "annotation_rationale": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_state": {
          "enum": [
            "PASS_A_ONLY",
            "ACCEPT",
            "REWRITE_FOR_SOURCE_FIDELITY",
            "MERGE_DUPLICATE",
            "SPLIT_ATOMIC_FACTS",
            "REJECT_NOT_IMPORTANT",
            "REJECT_UNSUPPORTED"
          ]
        }
      }
    },
    "annotation_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_first",
        "extract_outputs_viewed",
        "annotator_id",
        "annotated_at",
        "adjudicator_id",
        "adjudicated_at"
      ],
      "properties": {
        "source_first": {
          "const": true
        },
        "extract_outputs_viewed": {
          "const": false
        },
        "annotator_id": {
          "type": "string",
          "minLength": 1
        },
        "annotated_at": {
          "type": "string",
          "format": "date-time"
        },
        "adjudicator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjudicated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
