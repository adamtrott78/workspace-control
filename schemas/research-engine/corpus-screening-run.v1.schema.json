{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engine.local/schemas/corpus-screening-run.v1.schema.json",
  "title": "Research Engine CorpusScreeningRun v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "screening_run_id",
    "research_scope",
    "created_at",
    "note",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "screening_run_id": {
      "type": "string",
      "minLength": 1
    },
    "research_scope": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "corpus-decision.v1.schema.json"
      }
    }
  }
}
