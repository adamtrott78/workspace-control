{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engine.local/schemas/corpus-manifest.v1.schema.json",
  "title": "Research Engine CorpusManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "research_scope",
    "discovery_runs",
    "candidate_count_raw",
    "unique_provider_work_count",
    "identity_observations",
    "acquisition_observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "research_scope": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "discovery_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_count_raw": {
      "type": "integer",
      "minimum": 0
    },
    "unique_provider_work_count": {
      "type": "integer",
      "minimum": 0
    },
    "identity_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "records",
          "note"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acquisition_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "state",
          "note"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
