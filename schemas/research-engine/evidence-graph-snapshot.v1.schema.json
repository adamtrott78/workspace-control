{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engine.local/schemas/evidence-graph-snapshot.v1.schema.json",
  "title": "Research Engine EvidenceGraphSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "source_runs",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_runs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "node_type",
          "record_ref",
          "verification_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "type": "string",
            "minLength": 1
          },
          "record_ref": {
            "type": "string",
            "minLength": 1
          },
          "verification_state": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "relation_type",
          "derived_from"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation_type": {
            "type": "string",
            "minLength": 1
          },
          "derived_from": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  }
}
