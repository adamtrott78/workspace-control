{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engine.local/schemas/extraction-run.v1.schema.json",
  "title": "Research Engine ExtractionRun v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_run_id",
    "work_version_id",
    "source_identity",
    "source_level",
    "extractor",
    "started_at",
    "locators",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "extraction_run_id": {
      "type": "string",
      "minLength": 1
    },
    "work_version_id": {
      "type": "string",
      "minLength": 1
    },
    "source_identity": {
      "type": "string",
      "minLength": 1
    },
    "source_level": {
      "enum": [
        "METADATA_ONLY",
        "ABSTRACT_ONLY",
        "FULLTEXT_STRUCTURED",
        "FULLTEXT_PDF_TEXT",
        "FULLTEXT_PDF_LAYOUT",
        "OCR_DERIVED"
      ]
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "identity",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "locators": {
      "type": "array",
      "items": {
        "$ref": "source-locator.v1.schema.json"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence-object.v1.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
