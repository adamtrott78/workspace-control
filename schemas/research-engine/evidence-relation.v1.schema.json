{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engine.local/schemas/evidence-relation.v1.schema.json",
  "title": "Research Engine EvidenceRelation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relation_id",
    "source_id",
    "target_id",
    "relation_type",
    "basis_evidence_ids",
    "context_compatibility",
    "rationale",
    "verification_state",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "relation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_type": {
      "type": "string",
      "minLength": 1
    },
    "basis_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_compatibility": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "verification_state": {
      "enum": [
        "UNVERIFIED",
        "MACHINE_CHECKED",
        "HUMAN_VERIFIED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
