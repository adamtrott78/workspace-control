{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/lambda-ci-trusted-cache-promotion-receipt.v1.schema.json",
  "title": "Lambda CI Trusted Cache Promotion Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "promotion_authority",
    "promotion_recipe",
    "promoted_at",
    "project_id",
    "object_id",
    "artifact_kind",
    "descriptor",
    "descriptor_sha256",
    "tree_digest_sha256",
    "file_count",
    "materialized_bytes",
    "file_manifest",
    "quarantine_id",
    "quarantine_destroyed",
    "candidate_promotion_authorized",
    "offline_complete"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision": {
      "const": "PASS"
    },
    "promotion_authority": {
      "const": "root"
    },
    "promotion_recipe": {
      "const": "lambda-ci-trusted-cache-v1"
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_kind": {
      "enum": [
        "model",
        "runtime",
        "package",
        "test-fixture"
      ]
    },
    "descriptor": {
      "$ref": "lambda-ci-trusted-cache-descriptor.v1.schema.json"
    },
    "descriptor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tree_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "materialized_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "file_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "quarantine_id": {
      "type": "string",
      "format": "uuid"
    },
    "quarantine_destroyed": {
      "const": true
    },
    "candidate_promotion_authorized": {
      "const": false
    },
    "offline_complete": {
      "const": true
    }
  }
}
