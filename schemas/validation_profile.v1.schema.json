{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/validation_profile.v1.schema.json",
  "title": "Workspace Control Validation Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "default_tier", "force_full_tier", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "default_tier": {"$ref": "#/$defs/tier"},
    "force_full_tier": {"enum": ["FULL_INTEGRATION", "CANONICAL_REGRESSION"]},
    "tier_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      },
      "propertyNames": {"enum": ["FAST_STATIC", "TARGETED_PR", "FULL_INTEGRATION", "CANONICAL_REGRESSION"]}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "patterns", "tier", "checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "minLength": 1},
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "tier": {"$ref": "#/$defs/tier"},
          "checks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "tier": {"enum": ["FAST_STATIC", "TARGETED_PR", "FULL_INTEGRATION", "CANONICAL_REGRESSION"]}
  }
}
