{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/workflow_descriptor.v1.schema.json",
  "title": "Workspace Control Workflow Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","workflow_id","title","owner","entry_route","stages"],
  "properties": {
    "schema_version": {"const":1},
    "workflow_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$","minLength":1},
    "title":{"type":"string","minLength":1},
    "purpose":{"type":"string"},
    "owner":{"type":"object","additionalProperties":false,"required":["repository","context_path"],"properties":{"repository":{"type":"string","minLength":1},"context_path":{"type":"string","minLength":1}}},
    "entry_route":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "stages":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/stage"}},
    "forbidden_mutations":{"type":"array","items":{"type":"string","minLength":1}},
    "idempotency_identity":{"type":["string","null"]}
  },
  "$defs":{
    "stage":{
      "type":"object","additionalProperties":false,
      "required":["id","execution_owner","depends_on","validation"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$","minLength":1},
        "execution_owner":{"type":"string","minLength":1},
        "authority_owners":{"type":"array","items":{"type":"string"}},
        "depends_on":{"type":"array","items":{"type":"string"}},
        "required_capabilities":{"type":"array","items":{"type":"string"}},
        "deterministic_entrypoint":{"type":["string","null"]},
        "expected_artifacts":{"type":"array","items":{"type":"string"}},
        "artifact_lifecycle":{"type":"array","items":{"type":"object"}},
        "validation":{"type":"array","items":{"type":"string"}},
        "gates":{"type":"array","items":{"type":"string"}},
        "forbidden_mutations":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
