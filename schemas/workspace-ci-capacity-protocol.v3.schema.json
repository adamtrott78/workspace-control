{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-ci-capacity-protocol.v3.schema.json",
  "title": "Workspace CI Capacity Protocol v3",
  "oneOf": [
    {
      "title": "Provision request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "request_id",
        "runner_name",
        "jit_config"
      ],
      "properties": {
        "schema_version": {
          "const": 3
        },
        "operation": {
          "const": "PROVISION"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "runner_name": {
          "type": "string",
          "pattern": "^lambda-[A-Za-z0-9._-]{3,127}$"
        },
        "jit_config": {
          "type": "string",
          "minLength": 1,
          "maxLength": 174764
        }
      }
    },
    {
      "title": "Status request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "request_id"
      ],
      "properties": {
        "schema_version": {
          "const": 3
        },
        "operation": {
          "const": "STATUS"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "title": "Provision response",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "status",
        "request_id"
      ],
      "properties": {
        "schema_version": {
          "const": 3
        },
        "operation": {
          "const": "PROVISION_RESULT"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "DUPLICATE",
            "BUSY",
            "CLASS_QUARANTINED",
            "INVALID_REQUEST",
            "UNAUTHORIZED_PEER"
          ]
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "receipt_status": {
          "enum": [
            "ACCEPTED",
            "COMPLETED",
            "FAILED"
          ]
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,96}$"
        },
        "error": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    {
      "title": "Status response",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "status",
        "request_id"
      ],
      "properties": {
        "schema_version": {
          "const": 3
        },
        "operation": {
          "const": "STATUS_RESULT"
        },
        "status": {
          "enum": [
            "MISSING",
            "ACCEPTED",
            "COMPLETED",
            "FAILED"
          ]
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "runner_name": {
          "type": "string"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,96}$"
        },
        "error": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  ],
  "x-protocol-semantics": {
    "authority_source": "SO_PEERCRED uid mapped by root-owned runner-class catalog",
    "request_fields_non_authoritative_for_class": true,
    "jit_config_persistence": "FORBIDDEN_RAW; persist SHA-256 digest only",
    "status_classes": {
      "ACCEPTED": "runner-instance request durably claimed",
      "DUPLICATE": "same request identity already exists; reconcile receipt_status",
      "BUSY": "class capacity temporarily unavailable; no class/policy failure",
      "CLASS_QUARANTINED": "runner class blocked by durable containment state",
      "INVALID_REQUEST": "controller/root protocol incompatibility; controller-fatal",
      "UNAUTHORIZED_PEER": "local peer has no runner-class authority; controller/root configuration-fatal"
    }
  }
}
