{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/runtime_operation_receipt.v1.schema.json",
  "title": "Workspace Control Runtime Operation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "task_id",
    "git_sha",
    "operation_type",
    "execution_identity",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "$ref": "#/$defs/identity"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "git_sha": {
      "type": "string",
      "minLength": 1
    },
    "operation_type": {
      "type": "string",
      "minLength": 1
    },
    "execution_identity": {
      "$ref": "#/$defs/identity"
    },
    "status": {
      "enum": [
        "RUNNING",
        "PASS",
        "FAIL"
      ]
    },
    "terminal_stage": {
      "$ref": "#/$defs/stage"
    },
    "owner_process": {
      "$ref": "#/$defs/process"
    },
    "failure_envelope": {
      "$ref": "runtime_failure_envelope.v1.schema.json"
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stage": {
      "enum": [
        "C0_STATIC",
        "C1_IMPORT_ACCELERATOR",
        "C2A_BACKEND_TOOLCHAIN",
        "C2B_ENGINE_BOOT",
        "C3_CANARY",
        "C4_DOMAIN"
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "pid"
          ]
        },
        {
          "required": [
            "executable"
          ]
        },
        {
          "required": [
            "argv"
          ]
        }
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
