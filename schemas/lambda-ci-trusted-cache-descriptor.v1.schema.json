{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schemas/lambda-ci-trusted-cache-descriptor.v1.schema.json",
  "title": "Lambda CI Trusted Cache Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "artifact_kind",
    "source",
    "license",
    "serialization",
    "recipe"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "artifact_kind": {
      "enum": [
        "model",
        "runtime",
        "package",
        "test-fixture"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "immutable_revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "immutable_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reviewed": {
          "const": true
        }
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "unsafe_deserialization",
        "custom_code"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "unsafe_deserialization": {
          "const": false
        },
        "custom_code": {
          "const": false
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation_sha"
      ],
      "properties": {
        "id": {
          "const": "lambda-ci-trusted-cache-v1"
        },
        "implementation_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
