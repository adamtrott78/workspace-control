{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-semantic-execution-operator-action-schema-v0.1",
  "title": "Workspace Semantic Execution OperatorAction v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "generation",
    "action_type",
    "status",
    "priority_rank",
    "queue_sequence",
    "created_at",
    "task_id",
    "human_requirement",
    "ack_mode",
    "post_local_success",
    "local_plan"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "action_type": {
      "enum": [
        "SERVICE_EXISTING",
        "CREATE_AND_SERVICE",
        "RESTORE_AND_SERVICE",
        "DISCARD_SESSION",
        "RETIRE_SESSION",
        "OPEN_JUDGMENT_GATE",
        "OPEN_RECOVERY"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "CLAIMED_LOCAL",
        "LOCAL_PREPARED",
        "AWAITING_DURABLE_ACK",
        "ACKNOWLEDGED",
        "COMPLETED",
        "FAILED_LOCAL",
        "CLAIM_EXPIRED",
        "BLOCKED",
        "STALE",
        "SUPERSEDED"
      ]
    },
    "priority_rank": {
      "type": "integer",
      "minimum": 0,
      "description": "Lower integer sorts earlier. Semantic priority is assigned by the orchestrator, not the local helper."
    },
    "queue_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic deterministic tie-breaker after priority_rank."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "stale_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_process_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "worker_slot_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "session_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": null
    },
    "executor_requirement_ref": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "packet": {
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": false,
      "required": [
        "payload_ref",
        "content_sha256"
      ],
      "properties": {
        "payload_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "human_requirement": {
      "enum": [
        "NONE",
        "PASTE_AND_SUBMIT",
        "SUBSTANTIVE_DECISION",
        "RECOVERY_INTERACTION"
      ]
    },
    "ack_mode": {
      "enum": [
        "NONE",
        "DURABLE_WORKER_TRANSITION",
        "AUTHORITY_PATH_TRANSITION"
      ]
    },
    "durable_ack_condition": {
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": true,
      "description": "Typed condition evaluated only against authoritative durable events/state. Never ChatGPT page state."
    },
    "post_local_success": {
      "enum": [
        "AWAIT_DURABLE_ACK",
        "COMPLETE_AND_REQUERY",
        "COMPLETE_AND_STOP"
      ]
    },
    "local_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "operation",
          "idempotency_key"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "ENSURE_WORKER_PROFILE",
              "CREATE_TAB",
              "ACTIVATE_TAB",
              "RELOAD_TAB",
              "DISCARD_TAB",
              "CLOSE_TAB",
              "WRITE_CLIPBOARD",
              "OPEN_OPERATOR_CONSOLE"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "worker_slot_id": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "session_generation": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "default": null
          },
          "payload_ref": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    "claim": {
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": false,
      "required": [
        "claim_id",
        "helper_instance_id",
        "claimed_at",
        "expires_at"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "helper_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "supersedes_action_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "superseded_by_action_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "local_effect_state": {
          "enum": [
            "NONE_CONFIRMED",
            "APPLIED_CONFIRMED",
            "UNKNOWN"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "human_requirement": {
            "const": "PASTE_AND_SUBMIT"
          }
        }
      },
      "then": {
        "required": [
          "packet",
          "worker_slot_id",
          "session_generation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ack_mode": {
            "const": "NONE"
          }
        }
      },
      "then": {
        "properties": {
          "durable_ack_condition": {
            "type": [
              "null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "post_local_success": {
            "const": "AWAIT_DURABLE_ACK"
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "ack_mode": {
              "const": "NONE"
            }
          }
        }
      }
    }
  ]
}
