  "telemetry_denylist": [
    "arbitrary_clipboard_contents",
    "chatgpt_response_text_scraped_from_page",
    "passwords_or_authentication_secrets",
    "keystroke_streams",
    "mouse_trajectories",
    "unrelated_browsing_history"
  ],
  "known_recovery_requirements": [
    {
      "id": "SESSION_AUTH_REFRESH_ALL_TABS",
      "description": "Creating or using a new ChatGPT tab may trigger reauthentication, and login may refresh or invalidate existing worker tabs.",
      "required_outcome": "Recover from durable state and re-establish worker sessions without manual scheduler-state reconstruction.",
      "detailed_design_owner": "UX-07",
      "session_policy_owner": "UX-04"
    }
  ]
}
