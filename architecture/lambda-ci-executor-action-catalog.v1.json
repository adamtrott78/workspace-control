  "status": "MODEL_ONLY_NOT_LIVE",
  "generation_source": "architecture/lambda-ci-runner-class-catalog.v1.json",
  "rules": [
    "executors select an action_id and typed arguments; they do not supply a raw command string",
    "builder validates arguments before mutating GitHub",
    "builder reads current PR head when candidate_sha is omitted by a higher-level convenience API",
    "builder renders exactly one canonical slash-command representation",
    "rendered command is consumed by trusted workflow ingress only; infrastructure controller/root never parse it",
    "unknown action_id or argument is rejected locally",
    "legacy self-hosted workflow commands not in this catalog are unsupported"
  ],
