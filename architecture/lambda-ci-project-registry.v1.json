{
  "schema_version": 1,
  "registry_id": "lambda-ci-project-registry-v1",
  "status": "ACTIVE",
  "registry_epoch": 3,
  "authority": {
    "owner": "workspace-control",
    "allowed_repository_owners": [
      "adamtrott78"
    ],
    "target_repository_policy_authority": false,
    "candidate_invocable_reconciliation": false,
    "max_projects": 16
  },
  "derivation": {
    "project_id_pattern": "^[a-z][a-z0-9-]{1,20}$",
    "runner_user_template": "ci-{project_id}",
    "runner_group_template": "ci-{project_id}",
    "project_root_template": "/srv/workspace-ci/{project_id}",
    "manifest_install_template": "/etc/workspace-ci/projects/{project_id}.json",
    "controller_config_root": "/etc/workspace-ci/controllers",
    "cpu_scale_set_template": "lambda-{project_id}",
    "gpu_scale_set_template": "lambda-{project_id}-gpu",
    "cpu_runner_prefix_template": "lambda-{project_id}-",
    "gpu_runner_prefix_template": "lambda-{project_id}-gpu-",
    "transient_unit_template": "workspace-ci-{project_id}-{request_id}.service"
  },
  "reconciliation": {
    "source_repository": "adamtrott78/workspace-control",
    "source_default_branch": "main",
    "trusted_workflow_path": ".github/workflows/lambda-ci-project-reconcile.yml",
    "allowed_actor_logins": [
      "adamtrott78"
    ],
    "operation": "ADD_OR_UPDATE_ONLY_V1",
    "project_removal_requires_operator": true,
    "target_repository_candidate_invocable": false,
    "root_socket_group": "workspace-ci-reconciler",
    "arbitrary_commands_allowed": false,
    "arbitrary_paths_allowed": false,
    "arbitrary_systemd_properties_allowed": false
  },
  "projects": {
    "research-engine": {
      "repository": "adamtrott78/research-engine",
      "repository_visibility": "private",
      "manifest_source_path": "architecture/lambda-ci-project-research-engine.v2.json",
      "activation_state": "ACTIVE",
      "lanes": [
        "cpu",
        "gpu"
      ]
    },
    "padataset": {
      "repository": "adamtrott78/PADataset",
      "repository_visibility": "public",
      "manifest_source_path": "architecture/lambda-ci-project-padataset.v1.json",
      "activation_state": "P6_PILOT_PLANNED_NOT_INSTALLED",
      "lanes": [
        "cpu",
        "gpu"
      ]
    }
  }
}
