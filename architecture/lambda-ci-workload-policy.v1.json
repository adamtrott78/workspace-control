  "payload_network_classes": {
    "GITHUB_CONTROL_PLANE_PLUS_PUBLIC_PAYLOAD": {
      "description": "Accepted P5 compatibility mode: runner control plane plus public payload egress; private/local/production services remain denied."
    },
    "GITHUB_CONTROL_PLANE_ONLY_PAYLOAD_OFFLINE": {
      "description": "GitHub runner control traffic may remain outside the payload sandbox; candidate/model payload gets no public model/network egress."
    },
    "TRUSTED_ARTIFACT_ACQUISITION_ONLY": {
      "description": "No candidate payload. A trusted fetcher may contact only the declared public model/package source path and unavoidable public CDN redirects; private/local/production ranges remain denied."
    },
    "NO_NETWORK": {
      "description": "No payload or trusted-operation network access beyond local IPC required by the bounded operation."
    }
  },
