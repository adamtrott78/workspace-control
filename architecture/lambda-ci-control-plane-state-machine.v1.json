{
  "schema_version": 1,
  "model_id": "lambda-ci-control-plane-state-machine-v1",
  "status": "MODEL_ONLY_NOT_LIVE",
  "upstream": {
    "scale_set_client_commit": "e6daac702355cdb5b880b4fbdcf6d85dcd9e48e5",
    "scale_signal": "RunnerScaleSetStatistic.TotalAssignedJobs",
    "acknowledgment_rule": "listener deletes a message only after Scale returns nil; non-nil Scale error stops listener and leaves message for redelivery"
  },
  "state_machines": {
    "github_job": {
      "owner": "GitHub Actions service",
      "states": [
        "AVAILABLE",
        "ACQUIRED_ASSIGNED",
        "STARTED",
        "COMPLETED",
        "CANCELED_REQUEUED"
      ],
      "transitions": [
        {
          "from": "AVAILABLE",
          "event": "trusted controller AcquireJobs accepts RunnerRequestID",
          "to": "ACQUIRED_ASSIGNED"
        },
        {
          "from": "ACQUIRED_ASSIGNED",
          "event": "runner begins job",
          "to": "STARTED"
        },
        {
          "from": "STARTED",
          "event": "job terminal success/failure/cancel",
          "to": "COMPLETED"
        },
        {
          "from": "ACQUIRED_ASSIGNED",
          "event": "GitHub assignment timeout/cancel and requeue",
          "to": "CANCELED_REQUEUED"
        },
        {
          "from": "CANCELED_REQUEUED",
          "event": "GitHub makes job available again",
          "to": "AVAILABLE"
        }
      ],
      "invariant": "controller never derives queue depth from lifecycle-message counts"
    },
    "controller_job_admission": {
      "owner": "unprivileged runner-class controller",
      "states": [
        "OBSERVED",
        "ATTESTING",
        "TRUSTED",
        "DENIED",
        "DEFERRED",
        "ACQUIRE_REQUESTED",
        "ACQUIRED"
      ],
      "transitions": [
        {
          "from": "OBSERVED",
          "event": "JobAvailable",
          "to": "ATTESTING"
        },
        {
          "from": "ATTESTING",
          "event": "exact repository/workflow/blob/event/actor policy passes",
          "to": "TRUSTED"
        },
        {
          "from": "ATTESTING",
          "event": "stable policy mismatch",
          "to": "DENIED"
        },
        {
          "from": "ATTESTING",
          "event": "temporary GitHub observation unavailable",
          "to": "DEFERRED"
        },
        {
          "from": "TRUSTED",
          "event": "AcquireJobs called",
          "to": "ACQUIRE_REQUESTED"
        },
        {
          "from": "ACQUIRE_REQUESTED",
          "event": "RunnerRequestID returned as acquired",
          "to": "ACQUIRED"
        },
        {
          "from": "ACQUIRE_REQUESTED",
          "event": "not acquired / reassigned / capacity changed",
          "to": "DEFERRED"
        }
      ],
      "invariant": "human command tokens, candidate SHA and experiment parameters are absent from infrastructure admission"
    },
    "controller_supervisor": {
      "owner": "runner-class controller process",
      "states": [
        "BOOTSTRAP",
        "SESSION_ACTIVE",
        "RETRY_BACKOFF",
        "FATAL"
      ],
      "transitions": [
        {
          "from": "BOOTSTRAP",
          "event": "static config/catalog valid and scale-set session established",
          "to": "SESSION_ACTIVE"
        },
        {
          "from": "SESSION_ACTIVE",
          "event": "request-local deny or root class quarantine",
          "to": "SESSION_ACTIVE"
        },
        {
          "from": "SESSION_ACTIVE",
          "event": "retryable GitHub/root transport/session failure",
          "to": "RETRY_BACKOFF"
        },
        {
          "from": "RETRY_BACKOFF",
          "event": "bounded backoff elapsed",
          "to": "BOOTSTRAP"
        },
        {
          "from": "BOOTSTRAP",
          "event": "invalid static identity/catalog/durable state",
          "to": "FATAL"
        },
        {
          "from": "SESSION_ACTIVE",
          "event": "protocol corruption / impossible root response",
          "to": "FATAL"
        }
      ],
      "invariant": "systemd restart is not the request retry mechanism; request-local failures cannot consume StartLimitBurst"
    },
    "runner_instance": {
      "owner": "controller + root capacity provider",
      "states": [
        "ABSENT",
        "JIT_REGISTERED",
        "ROOT_ACCEPTED",
        "RUNNER_ONLINE",
        "BUSY",
        "TERMINAL",
        "CLEANED",
        "FAILED"
      ],
      "transitions": [
        {
          "from": "ABSENT",
          "event": "GenerateJitRunnerConfig succeeds",
          "to": "JIT_REGISTERED"
        },
        {
          "from": "JIT_REGISTERED",
          "event": "root PROVISION accepted",
          "to": "ROOT_ACCEPTED"
        },
        {
          "from": "ROOT_ACCEPTED",
          "event": "ephemeral runner registers/awaits job",
          "to": "RUNNER_ONLINE"
        },
        {
          "from": "RUNNER_ONLINE",
          "event": "JobStarted identifies runner",
          "to": "BUSY"
        },
        {
          "from": "BUSY",
          "event": "JobCompleted or runner exits",
          "to": "TERMINAL"
        },
        {
          "from": "TERMINAL",
          "event": "root verifies cgroup/process/GPU/workspace cleanup",
          "to": "CLEANED"
        },
        {
          "from": "JIT_REGISTERED",
          "event": "root rejects before launch or launch fails",
          "to": "FAILED"
        },
        {
          "from": "ROOT_ACCEPTED",
          "event": "launch/registration fails",
          "to": "FAILED"
        },
        {
          "from": "FAILED",
          "event": "cleanup verified",
          "to": "CLEANED"
        }
      ],
      "invariant": "runner instance is disposable and class-homogeneous; no instance carries job-specific root authority"
    },
    "root_capacity_request": {
      "owner": "root provisioner",
      "states": [
        "MISSING",
        "ACCEPTED",
        "COMPLETED",
        "FAILED"
      ],
      "transitions": [
        {
          "from": "MISSING",
          "event": "authenticated class peer submits new request_id/digest and class not quarantined",
          "to": "ACCEPTED"
        },
        {
          "from": "ACCEPTED",
          "event": "runner exits and cleanup passes",
          "to": "COMPLETED"
        },
        {
          "from": "ACCEPTED",
          "event": "launch/execution fails but cleanup passes",
          "to": "FAILED"
        }
      ],
      "side_state": [
        "RUNNER_CLASS_QUARANTINED"
      ],
      "invariant": "root derives runner class from authenticated local peer identity and root catalog; request cannot select or widen class"
    }
  },
  "error_algebra": {
    "REQUEST_LOCAL": {
      "examples": [
        "UNTRUSTED_WORKFLOW",
        "EVENT_NOT_ALLOWED",
        "ACTOR_NOT_ALLOWED",
        "AMBIGUOUS_STATIC_JOB_CORRELATION",
        "CLASS_QUARANTINED",
        "DUPLICATE_TERMINAL"
      ],
      "listener_action": "handle durably and return nil; message may be acknowledged",
      "process_action": "stay running"
    },
    "DEFER_RETRYABLE": {
      "examples": [
        "GITHUB_REST_TRANSIENT",
        "SCALESET_API_TRANSIENT",
        "ROOT_SOCKET_TRANSIENT",
        "JIT_API_TRANSIENT"
      ],
      "listener_action": "preserve/redeliver work according to explicit retry strategy",
      "process_action": "supervisor reconnect/backoff without consuming systemd crash-loop budget"
    },
    "CAPACITY_LOCAL": {
      "examples": [
        "ROOT_BUSY",
        "RUNNER_START_TRANSIENT",
        "ASSIGNMENT_REQUEUED"
      ],
      "listener_action": "converge from current TotalAssignedJobs",
      "process_action": "stay running"
    },
    "FATAL_CONFIGURATION_OR_CORRUPTION": {
      "examples": [
        "UNKNOWN_CONTROLLER_PEER",
        "RUNNER_CLASS_CATALOG_INVALID",
        "RUNNER_PREFIX_GENERATOR_VIOLATION",
        "DURABLE_LEDGER_CORRUPT",
        "ROOT_RESPONSE_SCHEMA_CORRUPT"
      ],
      "listener_action": "do not pretend request was handled",
      "process_action": "stop/fail for operator attention"
    }
  },
  "recovery_algorithm": [
    "load runner-instance durable ledger for this runner class",
    "query root STATUS for each nonterminal request",
    "reconcile/remove orphaned GitHub JIT runner registrations not represented by a live ledger entry",
    "establish fresh Scale Set Client session",
    "read current TotalAssignedJobs from session/message statistics",
    "desired runner capacity = min(class max_runners, TotalAssignedJobs)",
    "create homogeneous runner instances until live capacity converges to desired",
    "use JobStarted/JobCompleted only for runner busy/terminal evidence, not for backlog counting",
    "never reconstruct candidate SHA, route or human command to restore capacity"
  ],
  "maintenance_state_machine": {
    "ingress": "owner-authored maintenance command parsed once",
    "target_identity": "runner_class_id",
    "operations": [
      "DIAGNOSE_RUNNER_CLASS",
      "HOST_ATTEST_RUNNER_CLASS",
      "RESTART_RUNNER_CLASS_CONTROLLER",
      "RESET_STALE_RUNNER_CLASS"
    ],
    "invariant": "maintenance never enters scheduler execution protocol"
  },
  "reconciliation_state_machine": {
    "ingress": "successful exact trusted reconciliation workflow on workspace-control main",
    "effect": "atomically install/replace root runner-class catalog and class controller policies/identities",
    "invariant": "policy deployment is separate from candidate scheduling and execution"
  }
}
