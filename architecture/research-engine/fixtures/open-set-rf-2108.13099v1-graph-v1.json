    {
      "id": "ev:2108:rq:1",
      "node_type": "RESEARCH_QUESTION",
      "record_ref": "ev:2108:rq:1",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Determine whether a received RF signal comes from an authorized transmitter and, when authorized, identify which transmitter sent it."
      }
    },
    {
      "id": "ev:2108:dataset:1",
      "node_type": "DATASET_OR_POPULATION",
      "record_ref": "ev:2108:dataset:1",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "ORBIT WiFi testbed dataset using 71 transmitters and a USRP N210 receiver."
      }
    },
    {
      "id": "ev:2108:metric:1",
      "node_type": "METRIC",
      "record_ref": "ev:2108:metric:1",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Prediction accuracy of the OvA classifier on the held-out test set."
      }
    },
    {
      "id": "ev:2108:experiment:split",
      "node_type": "EXPERIMENT",
      "record_ref": "ev:2108:experiment:split",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Evaluation split uses 70% of authorized samples plus all known-outlier samples for train/validation, split 80/20; test contains all unknown-outlier samples plus remaining 30% of authorized samples."
      }
    },
    {
      "id": "ev:2108:method:vae",
      "node_type": "METHOD",
      "record_ref": "ev:2108:method:vae",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Supervised outlier generation trains a VAE on known unauthorized samples and uses its decoder to synthesize additional outliers."
      }
    },
    {
      "id": "ev:2108:experiment:vae",
      "node_type": "EXPERIMENT",
      "record_ref": "ev:2108:experiment:vae",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "VAE experiment fixes 10 authorized transmitters, varies known unauthorized transmitters over 5/10/15/20/25, and augments training with 7,500 generated outlier samples."
      }
    },
    {
      "id": "ev:2108:method:cvae",
      "node_type": "METHOD",
      "record_ref": "ev:2108:method:cvae",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "CVAE conditions the decoder on transmitter class so generated known-outlier samples can be allocated proportionally across classes."
      }
    },
    {
      "id": "ev:2108:result:cvae",
      "node_type": "RESULT",
      "record_ref": "ev:2108:result:cvae",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "CVAE augmentation produces a roughly uniform accuracy improvement across the evaluated known-outlier counts."
      }
    },
    {
      "id": "ev:2108:method:ellipsoid",
      "node_type": "METHOD",
      "record_ref": "ev:2108:method:ellipsoid",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Blind ellipsoidal generation maps authorized samples into latent space, encloses them with a minimum-volume ellipsoid, samples a surrounding shell, and decodes those points as synthetic outliers."
      }
    },
    {
      "id": "ev:2108:assumption:ellipsoid",
      "node_type": "ASSUMPTION",
      "record_ref": "ev:2108:assumption:ellipsoid",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "In latent space, valid unauthorized RF signals are assumed to be near authorized-signal representations while remaining separated from the authorized region."
      }
    },
    {
      "id": "ev:2108:experiment:ellipsoid",
      "node_type": "EXPERIMENT",
      "record_ref": "ev:2108:experiment:ellipsoid",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Ellipsoidal experiment uses 30 held-out outlier transmitters, authorized-set sizes 5/10/15/20/25, five random selections per size, and 7,500 generated outliers."
      }
    },
    {
      "id": "ev:2108:result:ellipsoid",
      "node_type": "RESULT",
      "record_ref": "ev:2108:result:ellipsoid",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "For small authorized sets, ellipsoidal augmentation yields testing-accuracy gains greater than 15 percentage points relative to the non-augmented comparison shown by the paper."
      }
    },
    {
      "id": "ev:2108:limitation:ellipsoid",
      "node_type": "LIMITATION",
      "record_ref": "ev:2108:limitation:ellipsoid",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "The ellipsoidal blind-generation method requires empirical tuning of shell-thickness parameter δ."
      }
    },
    {
      "id": "ev:2108:method:optimization",
      "node_type": "METHOD",
      "record_ref": "ev:2108:method:optimization",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Optimization-based blind generation minimizes latent distance while using an |A|+1 classifier loss to drive decoded samples toward the unauthorized class, with iterative judge retraining."
      }
    },
    {
      "id": "ev:2108:result:optimization",
      "node_type": "RESULT",
      "record_ref": "ev:2108:result:optimization",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Optimization-based blind generation achieves results similar to the ellipsoidal method and additionally shows an improvement at |A|=15 in the reported experiment."
      }
    },
    {
      "id": "ev:2108:limitation:optimization",
      "node_type": "LIMITATION",
      "record_ref": "ev:2108:limitation:optimization",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "Generating 1,000 outlier samples with the optimization method took about 30 times as long as with the ellipsoidal method."
      }
    },
    {
      "id": "ev:2108:claim:conclusion",
      "node_type": "CLAIM",
      "record_ref": "ev:2108:claim:conclusion",
      "verification_state": "MACHINE_CHECKED",
      "attributes": {
        "normalized_form": "The authors conclude that generative outlier augmentation can reduce or replace the need to acquire physical transmitters solely as known outliers for RF authentication training."
      }
    }
  ],
