{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-control.local/schema/lambda-ci-execution-profile.v1.schema.json",
  "title": "Lambda CI Execution Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "runner",
    "roots",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "group",
        "scale_set_name",
        "runner_group_id",
        "actions_runner_path",
        "api_version",
        "name_prefix"
      ],
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "scale_set_name": {
          "type": "string",
          "minLength": 1
        },
        "runner_group_id": {
          "type": "integer",
          "minimum": 1
        },
        "actions_runner_path": {
          "type": "string",
          "pattern": "^/"
        },
        "api_version": {
          "type": "string",
          "minLength": 1
        },
        "name_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs",
        "staging_cache",
        "trusted_cache",
        "home",
        "logs"
      ],
      "properties": {
        "jobs": {
          "type": "string",
          "pattern": "^/"
        },
        "staging_cache": {
          "type": "string",
          "pattern": "^/"
        },
        "trusted_cache": {
          "type": "string",
          "pattern": "^/"
        },
        "home": {
          "type": "string",
          "pattern": "^/"
        },
        "logs": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_scope",
        "job_permissions",
        "persist_checkout_credentials"
      ],
      "properties": {
        "token_scope": {
          "type": "string",
          "enum": [
            "repository-administration-write-jit-only"
          ]
        },
        "job_permissions": {
          "type": "object"
        },
        "persist_checkout_credentials": {
          "const": false
        }
      }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runner_labels",
          "max_runtime_seconds",
          "resources",
          "network",
          "filesystem",
          "dependencies",
          "receipt"
        ],
        "properties": {
          "runner_labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "max_runtime_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "requires_explicit_task_authorization": {
            "type": "boolean",
            "default": false
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpu_quota_percent",
              "memory_max_bytes",
              "tasks_max",
              "gpu_indices"
            ],
            "properties": {
              "cpu_quota_percent": {
                "type": "integer",
                "minimum": 100
              },
              "memory_high_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "memory_max_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "tasks_max": {
                "type": "integer",
                "minimum": 1
              },
              "gpu_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              }
            }
          },
          "network": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allow_public_egress",
              "allow_production_services",
              "deny_local_subnets"
            ],
            "properties": {
              "allow_public_egress": {
                "type": "boolean"
              },
              "allow_production_services": {
                "const": false
              },
              "deny_local_subnets": {
                "const": true
              }
            }
          },
          "filesystem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trusted_cache_read_only",
              "candidate_workspace_ephemeral",
              "deny_personal_home",
              "deny_docker_socket"
            ],
            "properties": {
              "trusted_cache_read_only": {
                "const": true
              },
              "candidate_workspace_ephemeral": {
                "const": true
              },
              "deny_personal_home": {
                "const": true
              },
              "deny_docker_socket": {
                "const": true
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "mode"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "required-runtime",
                    "required-receipt",
                    "none"
                  ]
                },
                "manifest_path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "expected_identity": {
                  "type": "object"
                }
              }
            }
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "filename"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "filename": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+\\.json$"
              }
            }
          }
        }
      }
    }
  }
}
