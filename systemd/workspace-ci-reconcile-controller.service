[Unit]
Description=Workspace CI GitHub project reconciliation controller
Documentation=https://github.com/adamtrott78/workspace-control
Requires=workspace-ci-reconciler.service
After=network-online.target workspace-ci-reconciler.service
Wants=network-online.target

[Service]
Type=simple
User=ci-reconciler
Group=workspace-ci-reconciler
ExecStart=/opt/workspace-ci/reconcile-controller/lambda_ci_reconcile_controller.py
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.53/32
IPAddressDeny=127.0.0.0/8
IPAddressDeny=::1/128
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fe80::/10
IPAddressDeny=fc00::/7
ReadOnlyPaths=/var/lib/workspace-ci/reconcile-controller/github-token
ReadWritePaths=/var/lib/workspace-ci/reconcile-controller
InaccessiblePaths=/home/atrott /var/run/docker.sock /run/docker.sock /var/lib/workspace-ci/controller /var/lib/workspace-ci/provisioner /srv/workspace-ci
DevicePolicy=closed
TasksMax=128
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
