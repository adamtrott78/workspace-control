[Unit]
StartLimitIntervalSec=10min
StartLimitBurst=30
Description=Workspace CI GitHub gpu-small scale-set controller
Documentation=https://github.com/adamtrott78/workspace-control
Requires=workspace-ci-provisioner.service
After=network-online.target workspace-ci-provisioner.service
Wants=network-online.target

[Service]
Type=simple
User=ci-controller
Group=workspace-ci-controller
ExecStart=/opt/workspace-ci/controller/lambda-ci-controller
Environment=WORKSPACE_CI_GITHUB_URL=https://github.com/adamtrott78/research-engine
Environment=WORKSPACE_CI_SCALESET_NAME=lambda-research-engine-gpu
Environment=WORKSPACE_CI_PROJECT_ID=research-engine
Environment=WORKSPACE_CI_PROFILE=gpu-small
Environment=WORKSPACE_CI_ADMISSION_V2_ENABLED=YES
Environment=WORKSPACE_CI_PROVISIONER_SOCKET=/run/workspace-ci/provisioner.sock
Environment=WORKSPACE_CI_PAT_FILE=/var/lib/workspace-ci/controller/github-token
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.53/32
IPAddressDeny=127.0.0.0/8
IPAddressDeny=::1/128
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fe80::/10
IPAddressDeny=fc00::/7
ReadOnlyPaths=/var/lib/workspace-ci/controller/github-token
InaccessiblePaths=/home/atrott /var/run/docker.sock /run/docker.sock
DevicePolicy=closed
TasksMax=256
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
