[Unit]
Description=Workspace CI bounded root maintenance service
Documentation=https://github.com/adamtrott78/workspace-control
After=local-fs.target systemd-tmpfiles-setup.service
Before=workspace-ci-maintenance-controller.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/workspace-ci/maintenance/lambda_ci_maintenance_service.py --serve
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/workspace-ci
ReadWritePaths=/var/lib/workspace-ci/maintenance
ReadWritePaths=/var/lib/workspace-ci/controller/state
ReadOnlyPaths=/etc/workspace-ci /opt/workspace-ci /usr /bin /lib /lib64
InaccessiblePaths=/home/atrott /var/run/docker.sock /run/docker.sock /srv/workspace-ci
DevicePolicy=closed
TasksMax=64
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
